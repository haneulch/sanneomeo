# 공공데이터포털 API 키 — .env.local로 복사 후 발급 키 입력 (커밋 금지)
# 키는 서버(API Route)에서만 사용. NEXT_PUBLIC_ 접두사 붙이지 말 것 (브라우저 노출 방지).

# 한국등산트레킹지원센터_100대명산 목록정보 / 산림청_명산등산로 / 산림청_산 정보 조회
FOREST_API_KEY=

# 한국관광공사 TourAPI (국문·영문 관광정보서비스_GW)
TOUR_API_KEY=

# 국토교통부 TAGO (시외버스·열차)
TAGO_API_KEY=

# 기상청 단기예보 조회서비스
KMA_API_KEY=
