# 공공데이터포털 인증키 — .env.local로 복사 후 발급 키 입력 (커밋 금지)
#   cp .env.example .env.local
# 포털 마이페이지의 "일반 인증키(Decoding)" 값을 사용할 것 (Encoding 키 아님).
# 하나의 키로 승인받은 모든 API 호출 가능.
# 서버(API Route)에서만 사용 — NEXT_PUBLIC_ 접두사 금지 (브라우저 노출 방지).
DATA_GO_KR_KEY=

# ── Supabase (없으면 CSV 파일 폴백 + 로그인 버튼 숨김) ──
# 서버 전용 — 데이터 접근(service role, RLS 우회). 절대 NEXT_PUBLIC_ 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저용 — Auth(Google 로그인). anon key는 공개돼도 되는 값 (RLS가 지킴).
# 빌드 시점 인라인 — Docker 빌드는 build args로 주입 (GitHub repo Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
